APP_NAME="Salva la Jama"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Guayaquil
APP_LOCALE=es

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Supabase (Postgres) — Project Settings > Database > Connection string
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# JWT (php-open-source-saver/jwt-auth) — generar con: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60

# Firebase / mapas / push (rellenar antes de usar esas features)
FIREBASE_STORAGE_BUCKET=
GOOGLE_MAPS_API_KEY=
FCM_SERVER_KEY=

# KPIs de impacto
CO2_FACTOR_PER_KG=2.5
